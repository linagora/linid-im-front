{
  "name": "linid-im-front",
  "version": "0.0.1",
  "description": "The host app of LinID - Identity Manager",
  "productName": "LinID - Identity Manager",
  "contributors": [
    {
      "name": "Vincent Moittie",
      "email": "moittie.vincent@gmail.com",
      "url": "https://github.com/Zorin95670"
    },
    {
      "name": "Jordy Cabannes",
      "email": "jcabannes@linagora.com",
      "url": "https://github.com/jcabannes"
    },
    {
      "name": "Christophe Chevalier",
      "email": "cchevalier@linagora.com",
      "url": "https://github.com/christophechevalier"
    }
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\"",
    "type-check": "vue-tsc --noEmit",
    "validate": "pnpm type-check && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@linagora/linid-im-front-corelib": "github:linagora/linid-im-front-corelib",
    "@module-federation/enhanced": "0.21.4",
    "@quasar/extras": "1.17.0",
    "axios": "1.13.2",
    "pinia": "3.0.4",
    "quasar": "2.18.6",
    "vue": "3.5.24",
    "vue-i18n": "11.1.12",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@intlify/unplugin-vue-i18n": "11.0.1",
    "@module-federation/vite": "1.9.0",
    "@quasar/app-vite": "2.4.0",
    "@quasar/quasar-app-extension-testing": "2.2.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "1.2.4",
    "@quasar/vite-plugin": "1.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "20.19.9",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "4.0.14",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-plugin-headers": "1.3.3",
    "eslint-plugin-jsdoc": "61.2.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "happy-dom": "20.0.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vite-plugin-checker": "0.11.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.14",
    "vue-tsc": "3.1.3"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "pnpm": ">=10.20.0"
  },
  "packageManager": "pnpm@10.20.0"
}
